  "steps": [
    {"type": "wait", "ms": 200},
    {"type": "fade", "to": "none", "ms": 1200},
    {"type": "narration", "text": "작은 식탁. 의자 네 개에 하나를 더 끌어와 다섯 자리. 된장찌개, 계란말이, 김치, 멸치볶음."},
    {"type": "narration", "text": "아빠가 신문을 접으며 앉는다. 말이 적고 잘 웃는 얼굴."},
    {"type": "actor", "id": "dad", "action": "anim", "name": "sit", "hold": true},
    {"type": "actor", "id": "hajun", "action": "anim", "name": "eat", "hold": true},
    {"type": "narration", "text": "하준은 열 살쯤. 젓가락으로 계란말이를 먼저 집는다."},
    {"type": "say", "speaker": "아빠(잔상)", "text": "어서 와요. 많이 드세요.", "face": 1},
    {"type": "say", "speaker": "하준(잔상)", "text": "누나 남자친구야?", "face": 1},
    {"type": "say", "speaker": "하린", "text": "아니거든!", "face": 3},
    {"type": "say", "speaker": "하준(잔상)", "text": "그럼 왜 데려왔는데?", "face": 1},
    {"type": "say", "speaker": "하린", "text": "친구라고! 친구!", "face": 3},
    {"type": "say", "speaker": "엄마(잔상)", "text": "하준아, 손님 앞에서. 계란말이 내려놔, 손님 먼저 드려야지.", "face": 1},
    {"type": "actor", "id": "hajun", "action": "anim", "name": "sit", "hold": true},
    {"type": "say", "speaker": "하준(잔상)", "text": "아 엄마아.", "face": 1},
    {"type": "narration", "text": "도윤은 숟가락을 든 채 가만히 있다. 이런 식탁이 너무 오랜만이다."},
    {"type": "explore", "only": ["stew"], "require": ["stew"], "freeze": true},
    {"type": "say", "speaker": "엄마(잔상)", "text": "입에 안 맞아요?", "face": 1},
    {"type": "player", "action": "anim", "name": "sit_eat"},
    {"type": "say", "speaker": "도윤", "text": "아뇨. (한 숟가락 먹는다) …맛있어요.", "face": 1},
    {"type": "player", "action": "anim", "name": "sit"},
    {"type": "say", "speaker": "엄마(잔상)", "text": "그쵸? 우리 하린이도 이거 제일 좋아해요. 밖에서 아무리 맛있는 거 먹고 와도 집에 오면 이거 찾아요.", "face": 1},
    {"type": "say", "speaker": "하린", "text": "엄마, 그런 얘기는 왜 해.", "face": 4},
    {"type": "say", "speaker": "아빠(잔상)", "text": "(웃으며) 맞잖아.", "face": 1},
    {"type": "parallel", "steps": [{"type": "glow", "color": "#ffb070", "alpha": 0.14, "ms": 1800}, {"type": "narration", "text": "식탁 위로 웃음소리가 오간다. 화면이 따뜻한 빛으로 채워진다."}]},
    {"type": "actor", "id": "harin", "action": "anim", "name": "chair_kick", "hold": true},
    {"type": "sfx", "name": "thud"},
    {"type": "shake", "ms": 120, "intensity": 0.002},
    {"type": "narration", "text": "하린이 식탁 아래로 도윤의 발을 툭 찬다."},
    {"type": "actor", "id": "harin", "action": "anim", "name": "chair", "hold": true},
    {"type": "say", "speaker": "하린", "text": "(작게) 이상하죠. 이렇게 멀쩡한데 밖은 하얗다니.", "face": 6},
    {"type": "say", "speaker": "도윤", "text": "(작게) …네.", "face": 1},
    {"type": "say", "speaker": "하린", "text": "(작게) 근데 이 순간은 좋다. 엄마 찌개는 진짜 맛있어요.", "face": 1},
    {"type": "actor", "id": "mom", "action": "move", "x": 432, "face": -1},
    {"type": "press", "count": 10, "button": "한 숟가락", "sfx": "chew", "anim": {"who": "player", "name": "sit_eat", "end": "sit"}, "lines": {"1": {"speaker": "아빠(잔상)", "text": "오늘 회사에서 김 과장이 또 도시락 두고 왔더라.", "bubble": true}, "2": {"speaker": "하준(잔상)", "text": "엄마, 나 오늘 받아쓰기 백 점!", "bubble": true}, "3": {"speaker": "엄마(잔상)", "text": "시장 생선 가게 아저씨가 고등어 하나 더 줬어.", "bubble": true}, "4": {"speaker": "아빠(잔상)", "text": "점심은 짜장면 먹었어. 곱빼기로.", "bubble": true}, "5": {"speaker": "하준(잔상)", "text": "우리 반 민수가 개구리 잡아 왔어.", "bubble": true}, "6": {"speaker": "엄마(잔상)", "text": "콩나물값이 또 올랐더라.", "bubble": true}, "7": {"speaker": "하준(잔상)", "text": "계란말이 하나만 더!", "bubble": true}, "8": {"speaker": "아빠(잔상)", "text": "하린이는 학교 재밌어?", "bubble": true}, "9": {"speaker": "엄마(잔상)", "text": "애호박은 시장 입구 할머니한테 샀어.", "bubble": true}, "10": {"speaker": "하준(잔상)", "text": "나 내일 소풍 가도 돼?", "bubble": true}}},
    {"type": "player", "action": "anim", "name": "sit_smile"},
    {"type": "say", "speaker": "엄마(잔상)", "text": "다 먹었으면 하린이 설거지.", "face": 1},
    {"type": "say", "speaker": "하린", "text": "손님 왔는데?!", "face": 3},
    {"type": "say", "speaker": "엄마(잔상)", "text": "손님 왔으니까 네가 하는 거지.", "face": 1},
