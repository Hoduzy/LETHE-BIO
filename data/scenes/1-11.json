  "steps": [
    {"type": "sfx", "name": "door"},
    {"type": "wait", "ms": 200},
    {"type": "fade", "to": "none", "ms": 900},
    {"type": "narration", "text": "도윤이 편의점에 들어온다. 앞치마는 입지 않았다."},
    {"type": "player", "action": "move", "x": 136, "face": -1},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "idle"},
    {"type": "say", "speaker": "민규", "text": "어? 너 오늘 근무 아니잖아.", "face": 5},
    {"type": "say", "speaker": "도윤", "text": "그만두려고. 점장님한테 말하러 왔어.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "그만둬? 왜?", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "취직했어.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "어디?", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "…레테.", "face": 5},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "talk"},
    {"type": "say", "speaker": "민규", "text": "(눈이 커진다) 진짜? 그 다이버? 야, 그럼 사백?!", "face": 3},
    {"type": "say", "speaker": "도윤", "text": "(작게) 응.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "미친. 야 축하해! 진짜 축하해! 오늘 내가… 아니다, 네가 사라. 사백인데.", "face": 1},
    {"type": "narration", "text": "민규가 웃는다. 진심으로 축하하는 얼굴이다. 도윤도 웃으려 한다."},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "whisper"},
    {"type": "say", "speaker": "민규", "text": "근데 어때? 진짜 남의 머릿속에 들어가?", "face": 4},
    {"type": "say", "speaker": "도윤", "text": "…응.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "어떤데? 무서워? 꿈 같아?", "face": 3},
    {"type": "say", "speaker": "도윤", "text": "(한참 생각한다) …그냥 집이었어.", "face": 2},
    {"type": "say", "speaker": "민규", "text": "집?", "face": 5},
    {"type": "say", "speaker": "도윤", "text": "어떤 사람 집. 가족들이 저녁 먹고 있었어.", "face": 2},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "shrug"},
    {"type": "say", "speaker": "민규", "text": "뭐야 그게. 생각보다 평화롭네.", "face": 1},
    {"type": "say", "speaker": "도윤", "text": "응.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "그럼 그거 캐 온 거야? 그 저녁?", "face": 3},
    {"type": "say", "speaker": "도윤", "text": "(대답하지 않는다)", "face": 2},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "talk"},
    {"type": "say", "speaker": "민규", "text": "야, 대박이다. 그거 부자들이 산다며. 남의 집 저녁을. (웃는다) 웃기다. 부자들은 집에서 밥 안 먹나?", "face": 1},
    {"type": "narration", "text": "도윤이 웃지 않는다. 민규가 눈치를 본다."},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "idle"},
    {"type": "say", "speaker": "민규", "text": "…아, 미안. 근데 뭐 어때. 그 사람 어차피 자고 있는 거잖아.", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "응.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "야, 그리고 나 나중에 소개 좀 시켜줘. 나도 하고 싶다.", "face": 1},
    {"type": "say", "speaker": "도윤", "text": "(바로) 하지 마.", "face": 4},
    {"type": "say", "speaker": "민규", "text": "왜?", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "…그냥. 너는 하지 마.", "face": 2},
    {"type": "say", "speaker": "민규", "text": "(서운한 얼굴) 뭐야. 너만 잘 먹고 잘 살려고?", "face": 5},
    {"type": "say", "speaker": "도윤", "text": "그런 거 아니야.", "face": 2},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "shrug"},
    {"type": "say", "speaker": "민규", "text": "(웃어넘긴다) 알았어, 알았어. 농담이야. 밥이나 사.", "face": 1},
    {"type": "fade", "to": "black", "ms": 1000},
    {"type": "narration", "text": "둘이 편의점 앞 플라스틱 의자에 앉아 컵라면을 먹는다. 도윤이 산다. 삼각김밥도 산다. 폐기가 아닌 걸로."},
    {"type": "wait", "ms": 400}
  ]
}
