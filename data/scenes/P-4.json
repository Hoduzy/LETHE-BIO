  "steps": [
    {"type": "narration", "text": "동네 편의점. 형광등. 냉장고 모터 소리."},
    {"type": "narration", "text": "카운터 안에 민규가 있다. 도윤이 앞치마를 받아 입는다."},
    {"type": "player", "action": "move", "x": 112, "face": -1},
    {"type": "say", "speaker": "민규", "text": "야, 얼굴 왜 그래. 죽은 사람 같아.", "face": 2, "anim": "talk"},
    {"type": "say", "speaker": "도윤", "text": "원래 이래.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "아니야, 오늘은 진짜 죽은 사람 같아. 무슨 일 있어?", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "…엄마 투석비 밀렸어.", "face": 2},
    {"type": "say", "speaker": "민규", "text": "얼마나?", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "삼 개월.", "face": 2},
    {"type": "say", "speaker": "민규", "text": "(휘파람) 야… 그거 금요일까지라며. 저번에 그랬잖아.", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "응.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "어떡하냐.", "face": 2},
    {"type": "say", "speaker": "도윤", "text": "모르겠어.", "face": 2},
    {"type": "narration", "text": "둘이 말없이 진열대를 정리한다."},
    {"type": "parallel", "steps": [{"type": "player", "action": "move", "x": 226, "face": 1}, {"type": "actor", "id": "mingyu", "action": "move", "x": 300, "speed": 40, "face": -1, "anim": "arrange"}]},
    {"type": "minigame", "game": "shelf", "title": "[미니게임: 진열 정리]", "lines": ["삼각김밥을 유통기한 순서대로. 제일 오래된 걸 앞으로.", "←→ 선택 · Z / Space 집기·놓기 · 터치"]},
    {"type": "actor", "id": "mingyu", "action": "anim", "name": "idle"},
    {"type": "say", "speaker": "민규", "text": "야, 그 회사 알아? 레테인가 뭔가.", "face": 4, "anim": "whisper"},
    {"type": "say", "speaker": "도윤", "text": "광고 봤어.", "face": 1},
    {"type": "say", "speaker": "민규", "text": "우리 사촌 형 친구가 거기 다닌대. 다이버라고, 혼수상태인 사람 머릿속에 들어가서 뭘 캐 온대.", "face": 4, "anim": "talk"},
    {"type": "say", "speaker": "도윤", "text": "뭘?", "face": 1},
    {"type": "say", "speaker": "민규", "text": "기억. 그걸 결정이라 그러던데. 그걸 부자들이 사서 체험한대. 남의 추억을.", "face": 3},
    {"type": "say", "speaker": "도윤", "text": "(멈칫) …그게 돼?", "face": 3},
    {"type": "say", "speaker": "민규", "text": "되니까 하겠지. 근데 그 형 친구, 한 달에 사백 번대. 사백.", "face": 3},
    {"type": "say", "speaker": "도윤", "text": "…사백.", "face": 3},
    {"type": "say", "speaker": "민규", "text": "학력도 필요 없대. 근데 이상한 소문도 있어. 오래 하면 사람이 좀 이상해진다던가.", "face": 4, "anim": "whisper"},
    {"type": "say", "speaker": "도윤", "text": "어떻게?", "face": 1},
    {"type": "say", "speaker": "민규", "text": "몰라. 그냥 멍해진대. (어깨를 으쓱) 근데 사백이면 나 같으면 멍해져도 해.", "face": 1, "anim": "shrug"},
    {"type": "sfx", "name": "door"},
