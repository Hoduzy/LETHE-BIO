    {"type": "actor", "id": "harin", "action": "anim", "name": "surprised"},
    {"type": "say", "speaker": "하린", "text": "(도윤을 본다. 겁먹은 얼굴) 봤어요? 엄마 이상하죠?", "face": 5},
